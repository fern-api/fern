// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`nullable alias snippets with legacyNullableAliasPointers > takes the address of aliases that already render as pointers 1`] = `
"package example

import (
	context "context"

	acme "github.com/acme/acme-go"
	client "github.com/acme/acme-go/client"
)

func do() {
	client := client.NewClient()
	request := &acme.Report{
		CreatedDate: acme.MustParseDate(
			"2023-01-15",
		),
		Description: func() *acme.NullableString {
			var value acme.NullableString = acme.String(
				"description",
			)
			return &value
		}(),
		TagsAlias: func() *acme.TagsAlias {
			var value acme.TagsAlias = &acme.NullableTags{
				"a",
			}
			return &value
		}(),
		MetadataAlias: func() *acme.MetadataAlias {
			var value acme.MetadataAlias = &acme.NullableMetadata{
				"key": "value",
			}
			return &value
		}(),
		Title: "title",
	}
	client.Reports.Create(
		context.TODO(),
		request,
	)
}
"
`;
