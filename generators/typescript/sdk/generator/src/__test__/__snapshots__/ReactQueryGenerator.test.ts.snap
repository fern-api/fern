exports[`ReactQueryGenerator > snapshot > generates complete namespace snapshot 3`] = `
"// This file was auto-generated by Fern from our API Definition.

import { createContext, useContext, createElement } from "react";
import type { ReactNode, ReactElement } from "react";
import type { SeedApiClient } from "../index.js";

const SeedApiClientContext = createContext<SeedApiClient | null>(null);

export interface SeedApiClientProviderProps {
    client: SeedApiClient;
    children: ReactNode;
}

export function SeedApiClientProvider(props: SeedApiClientProviderProps): ReactElement {
    return createElement(SeedApiClientContext.Provider, { value: props.client }, props.children);
}

export function useSeedApiClientContext(): SeedApiClient {
    const value = useContext(SeedApiClientContext);
    if (value === null) {
        throw new Error(
            "SeedApiClient not initialized. Create an instance of SeedApiClient and pass it to <SeedApiClientProvider />."
        );
    }
    return value;
}
"
`;

exports[`ReactQueryGenerator > snapshot > generates complete namespace snapshot 4`] = `
"// This file was auto-generated by Fern from our API Definition.

import type {
    UseQueryOptions,
    UseMutationOptions,
    UseSuspenseQueryOptions,
    UseInfiniteQueryOptions,
    UseSuspenseInfiniteQueryOptions,
    InfiniteData,
} from "@tanstack/react-query";

export type QueryHookOptions<TData, TError = Error> = Omit<
    UseQueryOptions<TData, TError>,
    "queryKey" | "queryFn"
>;

export type SuspenseQueryHookOptions<TData, TError = Error> = Omit<
    UseSuspenseQueryOptions<TData, TError>,
    "queryKey" | "queryFn"
>;

export type InfiniteQueryHookOptions<TData, TError = Error, TPageParam = unknown> = Omit<
    UseInfiniteQueryOptions<TData, TError, InfiniteData<TData>, readonly unknown[], TPageParam>,
    "queryKey" | "queryFn" | "initialPageParam" | "getNextPageParam"
>;

export type SuspenseInfiniteQueryHookOptions<TData, TError = Error, TPageParam = unknown> = Omit<
    UseSuspenseInfiniteQueryOptions<TData, TError, InfiniteData<TData>, readonly unknown[], TPageParam>,
    "queryKey" | "queryFn" | "initialPageParam" | "getNextPageParam"
>;

export type MutationHookOptions<TData, TError = Error, TVariables = void> = Omit<
    UseMutationOptions<TData, TError, TVariables>,
    "mutationKey" | "mutationFn"
>;
"
`;

