exports[`ReactQueryGenerator > snapshot > generates complete hooks file snapshot 2`] = `
"// This file was auto-generated by Fern from our API Definition.

import { createContext, useContext, createElement } from "react";
import type { ReactNode, ReactElement } from "react";
import type { SeedApiClient } from "../index.js";

const SeedApiClientContext = createContext<SeedApiClient | null>(null);

export interface SeedApiClientProviderProps {
    client: SeedApiClient;
    children: ReactNode;
}

export function SeedApiClientProvider(props: SeedApiClientProviderProps): ReactElement {
    return createElement(SeedApiClientContext.Provider, { value: props.client }, props.children);
}

export function useSeedApiClientContext(): SeedApiClient {
    const value = useContext(SeedApiClientContext);
    if (value === null) {
        throw new Error(
            "SeedApiClient not initialized. Create an instance of SeedApiClient and pass it to <SeedApiClientProvider />."
        );
    }
    return value;
}
"
`;

