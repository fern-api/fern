exports[`BaseClientTypeGenerator > server URL variables (region/edge routing) > uses the configured env var in single base URL server variable interpolation 1`] = `
"
export function normalizeClientOptions<T extends BaseClientOptions = BaseClientOptions>(
    options: T
): NormalizedClientOptions<T> {
    const headers = mergeHeaders(
        { "": "JavaScript", "": "@test/sdk", "": "1.0.0", "User-Agent": "@test/sdk/1.0.0", "X-Fern-Runtime": core.RUNTIME.type, "X-Fern-Runtime-Version": core.RUNTIME.version },
        options?.headers
    );

    let baseUrl = options?.baseUrl ?? (options?.environment == null ? process.env?.["MY_API_BASE_URL"] : undefined);
    if (options?.region != null) {
        const _region = options?.region ?? "us-east-1";
        if (baseUrl == null) {
            const _environmentUrls = new Map<unknown, string>([
                [environments.TestEnvironment.Default, \`https://api.\${_region}.example.com\`],
            ]);
            baseUrl = _environmentUrls.get(options?.environment) ?? \`https://api.\${_region}.example.com\`;
        }
    }

    return {
        ...options,
        baseUrl,
        logging: core.createLogger(options?.logging),
        headers,
    } as NormalizedClientOptions<T>;
}"
`;
