    {
      "id": "ssml-mixed",
      "name": "ssml-mixed",
      "xml": "<Response>\n    <Say>Hello <emphasis level=\"strong\">world<break strength=\"x-weak\"/>again</emphasis>, bye</Say>\n</Response>\n",
      "root": {
        "tag": "voice",
        "attributes": [],
        "content": [
          {
            "tag": "voice/say",
            "attributes": [],
            "content": [
              {
                "value": "Hello ",
                "type": "text"
              },
              {
                "tag": "voice/ssml_emphasis",
                "attributes": [
                  {
                    "name": "level",
                    "value": {
                      "value": "strong",
                      "type": "enum"
                    }
                  }
                ],
                "content": [
                  {
                    "value": "world",
                    "type": "text"
                  },
                  {
                    "tag": "voice/ssml_break",
                    "attributes": [
                      {
                        "name": "strength",
                        "value": {
                          "value": {
                            "wireValue": "x-weak",
                            "name": "x_weak"
                          },
                          "type": "enum"
                        }
                      }
                    ],
                    "content": [],
                    "type": "node"
                  },
                  {
                    "value": "again",
                    "type": "text"
                  }
                ],
                "type": "node"
              },
              {
                "value": ", bye",
                "type": "text"
              }
            ],
            "type": "node"
          }
        ]
      }
    }
