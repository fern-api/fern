      "xml": "<Response>\n    <Dial callerId=\"+15551112222\" hangupOnStar=\"true\">\n        <Number statusCallbackEvent=\"initiated ringing\" byoc=\"BY1234567890abcdef1234567890abcdef\">+15558675310</Number>\n    </Dial>\n</Response>\n",
      "root": {
        "tag": "voice",
        "attributes": [],
        "content": [
          {
            "tag": "voice/dial",
            "attributes": [
              {
                "name": "caller_id",
                "value": {
                  "value": "+15551112222",
                  "type": "string"
                }
              },
              {
                "name": "hangup_on_star",
                "value": {
                  "value": true,
                  "type": "boolean"
                }
              }
            ],
            "content": [
              {
                "tag": "voice/number",
                "attributes": [
                  {
                    "name": "status_callback_event",
                    "value": {
                      "items": [
                        {
                          "value": "initiated",
                          "type": "enum"
                        },
                        {
                          "value": "ringing",
                          "type": "enum"
                        }
                      ],
                      "type": "list"
                    }
                  },
                  {
                    "name": "byoc",
                    "value": {
                      "value": "BY1234567890abcdef1234567890abcdef",
                      "type": "string"
                    }
                  }
                ],
                "content": [
                  {
                    "value": "+15558675310",
                    "type": "text"
                  }
                ],
                "type": "node"
              }
            ],
            "type": "node"
          }
        ]
      }
    },
