language js

// The regex literal is matched on its source text because a backtick snippet cannot express `^/` directly.
or {
    `$value.replace($pattern, "")` where { $pattern <: r"^/\^\\/\+\|\\/\+\$/g$" },
    `$value?.replace($pattern, "")` where { $pattern <: r"^/\^\\/\+\|\\/\+\$/g$" }
} as $strip where {
    register_diagnostic(span=$strip, message="Use `stripLeadingAndTrailingSlashes` from `@fern-api/core-utils` instead of stripping slashes by hand.", severity="error")
}
